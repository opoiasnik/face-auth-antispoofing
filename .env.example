# Copy to .env (docker compose) or backend/.env (local run) and adjust.
# Generate secrets with:  cd backend && python -m app.cli generate-secrets

FA_ENVIRONMENT=development
FA_LOG_LEVEL=INFO

# --- secrets (REQUIRED in production) -------------------------------------
FA_SECURITY__JWT_SECRET=change-me-to-a-long-random-string
# FA_SECURITY__TEMPLATE_ENCRYPTION_KEY=<fernet key>
# Detailed scores in API responses help with tuning, but must be off in production
FA_SECURITY__EXPOSE_SCORES=true

# --- infrastructure -------------------------------------------------------
# FA_DATABASE_URL=postgresql+psycopg://user:pass@db:5432/faceauth
# FA_REDIS_URL=redis://localhost:6379/0
FA_CORS_ORIGINS=["http://localhost:5173"]

# --- decision thresholds (see docs/evaluation.md) -------------------------
FA_MATCHING__THRESHOLD=0.40
FA_PASSIVE_LIVENESS__THRESHOLD=0.70
FA_ACTIVE_LIVENESS__STEPS=2
FA_ACTIVE_LIVENESS__YAW_THRESHOLD=0.20
FA_ACTIVE_LIVENESS__PITCH_THRESHOLD=0.07
